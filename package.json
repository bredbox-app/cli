{
  "name": "@bredbox/cli",
  "version": "0.2.0",
  "description": "Command line interface for the Bredbox API",
  "type": "module",
  "bin": {
    "bredbox": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.ts)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nzakas"
  },
  "scripts": {
    "build": "tsc",
    "generate": "node scripts/generate.ts",
    "generate:offline": "node scripts/generate.ts --offline",
    "lint": "eslint src/ tests/ generator/ scripts/",
    "fmt": "prettier --write .",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bredbox-app/cli.git"
  },
  "homepage": "https://bredbox.app",
  "keywords": [
    "bredbox",
    "cli",
    "read-it-later",
    "bookmarks",
    "openapi"
  ],
  "author": "Nicholas C. Zakas",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bytecodealliance/jco": "1.37.0",
    "@cloudflare/forge": "https://pkg.pr.new/cloudflare/forge/@cloudflare/forge@7e230c1f40514ceffe7001823c158f4f0380f7bd",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "lint-staged": "17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yorkie": "2.0.0"
  },
  "dependencies": {}
}
